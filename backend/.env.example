# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Vertex AI (Google Cloud)
VERTEX_AI_PROJECT_ID=works-logue-prod
VERTEX_AI_LOCATION=asia-northeast1
VERTEX_AI_MAX_CONCURRENT=5

# System
SYSTEM_USER_ID=00000000-0000-0000-0000-000000000000  # UUID of AI facilitation system user

# Bloom thresholds (optional — defaults shown)
BLOOM_STRUCTURAL_THRESHOLD=0.8
BLOOM_LOG_COUNT=10
BLOOM_PARTICIPANT_COUNT=5
BLOOM_QUALITY_SCORE=0.7

# Vertex AI timeouts (seconds, optional — defaults shown)
VERTEX_AI_TIMEOUT_FLASH=8.0
VERTEX_AI_TIMEOUT_SCORING=60.0
VERTEX_AI_TIMEOUT_LOUGE=120.0
VERTEX_AI_TIMEOUT_CLEANSE=30.0
